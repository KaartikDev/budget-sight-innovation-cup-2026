PORT=4310
SESSION_SECRET=replace-with-a-long-random-value
# Optional: BudgetSight auto-discovers Codex on PATH and in the ChatGPT macOS app.
# CODEX_EXECUTABLE=/absolute/path/to/codex
# Comma-separated absolute directories. Repositories can be discovered or created only here.
REPO_ROOTS=/absolute/path/to/projects
DATA_DIR=./data
WEB_ORIGIN=http://localhost:5173
# Local feature extraction and reporting.
FEATURE_EXTRACTION_ENABLED=true
REPORTING_DB_PATH=./data/reporting.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama's 4B tag is the demo-sized local structured-output model.
FEATURE_EXTRACTOR_MODEL=qwen3:4b-instruct
FEATURE_EXTRACTOR_TIMEOUT_MS=30000
FEATURE_EXTRACTION_LOG_PATH=./data/feature-extraction.log
