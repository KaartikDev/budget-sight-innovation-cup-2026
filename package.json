{
  "name": "budgetsight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w @budgetsight/server",
    "dev:web": "npm run dev -w @budgetsight/web",
    "build": "npm run build -w @budgetsight/web",
    "start": "npm run start -w @budgetsight/server",
    "test": "npm run test -w @budgetsight/server && npm run test -w @budgetsight/web",
    "seed-user": "npm run seed-user -w @budgetsight/server",
    "seed-defaults": "npm run seed-defaults -w @budgetsight/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
